# Set these through the host environment. PHP does not automatically read this file.
ANAZORI_APP_ENV=production
ANAZORI_URL=https://anazori.ccsdu.in
ANAZORI_SITE_URL=https://anazori.ccsdu.in
ANAZORI_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
ANAZORI_DB_DRIVER=mysql
ANAZORI_DB_HOST=localhost
ANAZORI_DB_PORT=3306
ANAZORI_DB_NAME=your_database
ANAZORI_DB_USER=your_database_user
ANAZORI_DB_PASS=replace-with-database-password
# Native PHP mail(), using the host MTA. No SMTP password is needed.
# The hosting account shares one budget across all four addresses.
ANAZORI_PHP_MAIL_OTP_1=noreply1@ccsdu.in
ANAZORI_PHP_MAIL_OTP_2=noreply2@ccsdu.in
ANAZORI_PHP_MAIL_NOTICE_1=noreply3@ccsdu.in
ANAZORI_PHP_MAIL_NOTICE_2=noreply4@ccsdu.in
ANAZORI_PHP_MAIL_DAILY_LIMIT=90
ANAZORI_PHP_MAIL_PER_MINUTE=8
ANAZORI_PHP_MAIL_SENDER_DAILY_LIMIT=45
ANAZORI_PHP_MAIL_SENDER_PER_MINUTE=4
ANAZORI_MAIL_NOTIFICATIONS=1
# Absolute private paths outside public_html. PHP creates the folders automatically.
ANAZORI_PAYMENT_PROOF_DIR=/home/your-account/anazori-private/payment-proofs
ANAZORI_REGISTRATION_FILE_DIR=/home/your-account/anazori-private/registration-files
ANAZORI_STUDIO_RECEIPT_PATH=/home/your-account/anazori-private/studio-receipts
ANAZORI_SECRET_PATH=/home/your-account/anazori-private/application-key
# Local SQLite override, if used instead of MySQL:
# ANAZORI_DB_PATH=/absolute/private/path/anazori.sqlite
