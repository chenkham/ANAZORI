# Historical gateway setup: new checkout uses event-specific payment screenshot review. See README.md and docs/ARCHITECTURE.md.

# Template only: this PHP application does not automatically load .env files.
# Set these in the PHP server's environment, outside the public website.
# Never put real credentials in source control or a publicly accessible file.

ANAZORI_SITE_URL=https://anazori.ccsdu.in

# Optional: pin the environment here (sandbox / production).
# Omit ANAZORI_PHONEPE_ENV to let the master choose it in Organizer Studio.
ANAZORI_PHONEPE_ENV=sandbox

ANAZORI_PHONEPE_SANDBOX_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
ANAZORI_PHONEPE_SANDBOX_CLIENT_VERSION=YOUR_SANDBOX_CLIENT_VERSION
ANAZORI_PHONEPE_SANDBOX_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
ANAZORI_PHONEPE_SANDBOX_WEBHOOK_USERNAME=YOUR_SANDBOX_SHA_WEBHOOK_USERNAME
ANAZORI_PHONEPE_SANDBOX_WEBHOOK_PASSWORD=YOUR_SANDBOX_SHA_WEBHOOK_PASSWORD

ANAZORI_PHONEPE_PRODUCTION_CLIENT_ID=YOUR_PRODUCTION_CLIENT_ID
ANAZORI_PHONEPE_PRODUCTION_CLIENT_VERSION=YOUR_PRODUCTION_CLIENT_VERSION
ANAZORI_PHONEPE_PRODUCTION_CLIENT_SECRET=YOUR_PRODUCTION_CLIENT_SECRET
ANAZORI_PHONEPE_PRODUCTION_WEBHOOK_USERNAME=YOUR_PRODUCTION_SHA_WEBHOOK_USERNAME
ANAZORI_PHONEPE_PRODUCTION_WEBHOOK_PASSWORD=YOUR_PRODUCTION_SHA_WEBHOOK_PASSWORD

# Enable checkout in Studio after configuring and testing the matching credentials.
# ANAZORI_PAYMENT_ENABLED=0 can forcibly disable checkout on the host.
# Production must not set ANAZORI_TEST_MODE or ANAZORI_TEST_* variables.
